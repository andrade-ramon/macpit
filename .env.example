# Porta HTTP do dashboard (sempre ligado em 127.0.0.1)
MACPIT_PORT=7777
# Diretório de dados (SQLite, logs de execução, token). Padrão: ~/.macpit
MACPIT_DATA_DIR=
# Shell usado para executar ações
MACPIT_SHELL=/bin/bash
# Intervalo de coleta de métricas (ms)
MACPIT_SAMPLE_INTERVAL_MS=2000
# Intervalo de gravação do histórico de disco no SQLite (ms, mín. 10000)
MACPIT_DISK_SAMPLE_INTERVAL_MS=300000
